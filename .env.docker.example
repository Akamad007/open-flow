# Copy to `.env` (next to docker-compose.gpu.yml) and fill in to unlock real
# providers. Everything works in stub mode with this file empty — you'll still
# get real Wan2.2 video; only LLM story analysis + SD3.5 stills need keys.

# ── Real LLM story analysis (else a stub planner is used) ──
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# ── Real character stills via Stable Diffusion 3.5 (gated repo) ──
# IMAGE_PROVIDER=sd35
# HF_TOKEN=hf_...

# ── Real narration via Chatterbox TTS ──
# AUDIO_PROVIDER=chatterbox

# ── Optional: require an API key on the backend ──
# API_KEY=choose-a-secret
