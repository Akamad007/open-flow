# Normalize line endings.
* text=auto eol=lf

*.py   text eol=lf
*.sh   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Binary assets — never normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.svg  text
*.mp4  binary
*.wav  binary
*.pt   binary
*.pkl  binary
*.safetensors binary
