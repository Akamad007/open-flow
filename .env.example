# ─── Database ───
DATABASE_URL=postgresql+asyncpg://storyvideouser:storyvideopass@localhost:5432/storyvideo
DATABASE_URL_SYNC=postgresql://storyvideouser:storyvideopass@localhost:5432/storyvideo

# ─── Redis ───
REDIS_URL=redis://localhost:6379/0

# ─── Storage ───
STORAGE_ROOT=./storage

# ─── Secrets Manager (API key fetched at runtime — NEVER stored here) ───
SECRETS_MANAGER_URL=http://127.0.0.1:8010
SECRETS_MANAGER_TOKEN=your-drf-auth-token-here

# ─── LLM Provider ───
LLM_PROVIDER=openai
LLM_API_BASE=https://api.openai.com/v1
# LLM_API_KEY is NOT set here — it's fetched from secrets-manager at runtime
LLM_MODEL=gpt-4o-mini

# ─── Video Provider ───
VIDEO_PROVIDER=ltx
LTX_MODEL_ID=Lightricks/LTX-Video
LTX_NUM_FRAMES=49
LTX_HEIGHT=480
LTX_WIDTH=704
LTX_INFERENCE_STEPS=60
LTX_GUIDANCE_SCALE=3.5

# ─── Audio Provider ───
AUDIO_PROVIDER=chatterbox  # chatterbox | stub
CHATTERBOX_REFERENCE_AUDIO=./storage/audio/narrator_reference.wav
CHATTERBOX_MAX_CHUNK_CHARS=500

# ─── Stitching ───
FFMPEG_PATH=ffmpeg

# ─── Server ───
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]

# ─── Celery ───
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
