# OpenFlow configuration. Copy to `.env` and edit. `.env` is gitignored.
#
# PROFILES:
#   • No-GPU demo:  set the four *_PROVIDER vars to "stub" (see .env.stub).
#   • Full GPU:     LLM=openai VIDEO=wan22|ltx AUDIO=chatterbox IMAGE=sd35,
#                   plus model weights (see docs/MODELS_AND_WEIGHTS.md) and keys.
# [REQUIRED] / [OPTIONAL] markers below. Never put real secrets in this file.

# ─── Core services [REQUIRED] ───
DATABASE_URL=postgresql+asyncpg://storyvideouser:storyvideopass@localhost:5432/storyvideo
DATABASE_URL_SYNC=postgresql://storyvideouser:storyvideopass@localhost:5432/storyvideo
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
STORAGE_ROOT=./storage

# ─── API security [RECOMMENDED for any non-local deployment] ───
# When set, every /api route requires header `X-API-Key: <value>`.
# Empty = auth disabled (fine for localhost only). See SECURITY.md.
API_KEY=

# ─── Providers — pick a profile [REQUIRED] ───
# stub = no GPU/keys needed.  Real: openai / wan22 / ltx / chatterbox / sd35
LLM_PROVIDER=stub
VIDEO_PROVIDER=stub
AUDIO_PROVIDER=stub
IMAGE_PROVIDER=stub

# ─── LLM [REQUIRED if LLM_PROVIDER=openai] ───
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_STRONG_MODEL=gpt-4o-mini
# API key resolution order: secrets-manager (if configured) → this env var.
LLM_API_KEY=

# ─── Secrets manager [OPTIONAL] ───
# Leave SECRETS_MANAGER_URL empty to read keys directly from env vars above.
# If set, OpenFlow fetches OPENAI_API_KEY / YOUTUBE_* from the vault at runtime.
SECRETS_MANAGER_URL=
SECRETS_MANAGER_TOKEN=

# ─── Model weights [REQUIRED for GPU providers] ───
# MODELS_ROOT is the parent dir for downloaded weights (default <repo>/models).
# Override individual paths if your weights live elsewhere.
MODELS_ROOT=./models
# WAN22_MODEL_PATH=/abs/path/Wan2.2/TI2V-5B-Diffusers
# WAN22_MOTION_MODEL_PATH=/abs/path/Wan2.2/FrameINO-5B-MotionINO-v1.6
# WAN22_LORA_DIR=/abs/path/Wan2.2/loras/5b
HF_TOKEN=                      # required for gated SD 3.5; or run `huggingface-cli login`

# ─── Video provider tuning [OPTIONAL] ───
LTX_MODEL_ID=Lightricks/LTX-Video
LTX_NUM_FRAMES=73
LTX_WIDTH=1280
LTX_HEIGHT=768
LTX_INFERENCE_STEPS=80
LTX_FPS=12
WAN22_HEIGHT=384
WAN22_WIDTH=640
WAN22_NUM_FRAMES=121
WAN22_INFERENCE_STEPS=140

# ─── Audio provider [OPTIONAL] ───
CHATTERBOX_REFERENCE_AUDIO=./storage/audio/narrator_reference.wav
CHATTERBOX_MAX_CHUNK_CHARS=500

# ─── Image / identity [OPTIONAL] ───
SD35_MODEL_ID=stabilityai/stable-diffusion-3.5-medium
IDENTITY_PROVIDER_ENABLED=true
INSTANTID_DAEMON_ENABLED=true
# External InstantID scripts dir (not bundled — see docs/MODELS_AND_WEIGHTS.md).
INSTANTID_DIR=~/instantid
IMAGE_PREGEN_ENABLED=false

# ─── YouTube upload [OPTIONAL] ───
# YOUTUBE_OAUTH_PATH=~/.video-app/youtube_oauth.json
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=

# ─── Misc [OPTIONAL] ───
FFMPEG_PATH=ffmpeg
GPU_PYTHON_PATH=python
CONSISTENCY_GATE_ENABLED=true

# ─── Server ───
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8002
CORS_ORIGINS=["http://localhost:5173"]
