# OpenFlow — no-GPU demo profile.
# Run the full pipeline with zero GPU, zero model weights, zero API keys.
#   cp .env.stub .env   (then start Postgres + Redis, migrate, seed)
# Every generation step uses a stub provider that produces placeholder output.

DATABASE_URL=postgresql+asyncpg://storyvideouser:storyvideopass@localhost:5432/storyvideo
DATABASE_URL_SYNC=postgresql://storyvideouser:storyvideopass@localhost:5432/storyvideo
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
STORAGE_ROOT=./storage

# All-stub: no GPU, no keys.
LLM_PROVIDER=stub
VIDEO_PROVIDER=stub
AUDIO_PROVIDER=stub
IMAGE_PROVIDER=stub

# No external secrets vault.
SECRETS_MANAGER_URL=
API_KEY=

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8002
CORS_ORIGINS=["http://localhost:5173"]
